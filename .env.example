# Required
ANTHROPIC_API_KEY=your_api_key_here

# Optional (defaults shown)
MODEL_NAME=claude-sonnet-4-5-20250929
GENERATION_CYCLE_SECONDS=60
AGING_SECONDS=10
MAX_POPULATION=50
MUTATION_RATE=1.0

# LLM Mating Configuration
ENABLE_LLM_MATING=true
MAX_DATES_PER_CYCLE=5
MAX_PARALLEL_CONVERSATIONS=10
MIN_COMPATIBILITY=40.0
MAX_CONVERSATION_TURNS=2
PRE_FILTER_TRAIT_DISTANCE=10.0

# Skills (comma-separated)
AVAILABLE_SKILLS=hunting,gathering,crafting,communication,innovation,teaching

# Tools (comma-separated)
AVAILABLE_TOOLS=stone-tools,fire,calculator,memory
